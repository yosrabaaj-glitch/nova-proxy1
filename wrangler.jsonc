{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4b85b103-7d20-48f4-9047-c0ab18fd9373","database_name": "nova-proxy1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9b483d4d1d4146c0b579d20d3914d4ac" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
